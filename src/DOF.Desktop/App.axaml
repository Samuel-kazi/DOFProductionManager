<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DOF.Desktop.ViewModels"
             xmlns:pages="using:DOF.Desktop.ViewModels.Pages"
             xmlns:views="using:DOF.Desktop.Views"
             xmlns:pageViews="using:DOF.Desktop.Views.Pages"
             x:Class="DOF.Desktop.App"
             Name="DOF Production Manager"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml" />
        <ResourceInclude Source="/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Explicit view-model → view mapping (compile-time checked; no reflection-based view locator). -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel"><views:ShellView /></DataTemplate>
    <DataTemplate DataType="pages:DashboardViewModel"><pageViews:DashboardView /></DataTemplate>
    <DataTemplate DataType="pages:CalendarViewModel"><pageViews:CalendarView /></DataTemplate>
    <DataTemplate DataType="pages:ProjectsViewModel"><pageViews:ProjectsView /></DataTemplate>
    <DataTemplate DataType="pages:ShowsViewModel"><pageViews:ShowsView /></DataTemplate>
    <DataTemplate DataType="pages:ReleasesViewModel"><pageViews:ReleasesView /></DataTemplate>
    <DataTemplate DataType="pages:TasksViewModel"><pageViews:TasksView /></DataTemplate>
    <DataTemplate DataType="pages:TeamViewModel"><pageViews:TeamView /></DataTemplate>
    <DataTemplate DataType="pages:SettingsViewModel"><pageViews:SettingsView /></DataTemplate>
    <DataTemplate DataType="pages:PlaceholderPageViewModel"><pageViews:PlaceholderPageView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#B45F0E" />
        <ColorPaletteResources x:Key="Dark" Accent="#F0A24A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
