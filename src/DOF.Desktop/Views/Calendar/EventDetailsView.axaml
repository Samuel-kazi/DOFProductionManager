<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="using:DOF.Desktop.ViewModels.Calendar"
             xmlns:pages="using:DOF.Desktop.ViewModels.Pages"
             xmlns:pageViews="using:DOF.Desktop.Views.Pages"
             xmlns:conv="using:DOF.Desktop.Converters"
             xmlns:work="using:DOF.Desktop.ViewModels.Work"
             x:Class="DOF.Desktop.Views.Calendar.EventDetailsView"
             x:DataType="cal:EventDetailsViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="5"
            Background="{Binding CategoryBrushKey, Converter={x:Static conv:ResourceBrushConverter.Instance}}" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,16,12,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="pill"><TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" /></Border>
        <Border Classes="pill" IsVisible="{Binding IsCancelled}" Background="{DynamicResource Brush.ErrorSoft}">
          <TextBlock Text="Cancelled" FontSize="12" Foreground="{DynamicResource Brush.Offline}" />
        </Border>
      </StackPanel>
      <Button Grid.Column="1" Classes="toolbar" Content="✕" ToolTip.Tip="Close"
              Command="{Binding $parent[pageViews:CalendarView].((pages:CalendarViewModel)DataContext).CloseSidePanelCommand}" />
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,20" Spacing="10">
      <Border Classes="banner error" IsVisible="{Binding IsConfirmingCancel}">
        <StackPanel Spacing="8">
          <TextBlock Text="Cancel this event? It will be removed from the calendar but kept in the records." TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Cancel event"
                    Command="{Binding $parent[pageViews:CalendarView].((pages:CalendarViewModel)DataContext).ConfirmCancelEventCommand}"
                    CommandParameter="{Binding}" />
            <Button Content="Keep it"
                    Command="{Binding $parent[pageViews:CalendarView].((pages:CalendarViewModel)DataContext).KeepEventCommand}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsConfirmingCancel}">
        <Button Classes="accent" Content="Edit" IsVisible="{Binding CanEdit}"
                Command="{Binding $parent[pageViews:CalendarView].((pages:CalendarViewModel)DataContext).EditEventCommand}"
                CommandParameter="{Binding}" />
        <Button Content="Cancel event…" IsVisible="{Binding CanCancel}"
                Command="{Binding $parent[pageViews:CalendarView].((pages:CalendarViewModel)DataContext).AskCancelEventCommand}"
                CommandParameter="{Binding}" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer>
      <StackPanel Margin="20,10,20,0" Spacing="14">
        <TextBlock Classes="h2" FontSize="20" Text="{Binding Title}" TextWrapping="Wrap" />
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding WhenText}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Text="{Binding PriorityText}" />
        </StackPanel>

        <StackPanel Spacing="3" IsVisible="{Binding Location, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="muted small" Text="Location" />
          <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="3" IsVisible="{Binding MeetingUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="muted small" Text="Meeting link" />
          <SelectableTextBlock Text="{Binding MeetingUrl}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Accent}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="muted small" Text="People" />
          <ItemsControl ItemsSource="{Binding People}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Margin="0,1" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Google Calendar invites -->
        <Border Classes="card" Padding="12" IsVisible="{Binding HasInvites}" x:Name="GoogleInvites">
          <StackPanel Spacing="8" DataContext="{Binding Invites}" x:DataType="cal:GoogleInvitesViewModel">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted small" Text="Google Calendar" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="toolbar" Content="↻" ToolTip.Tip="Refresh answers" Padding="6,0"
                      Command="{Binding RefreshCommand}" IsVisible="{Binding IsActive}" />
            </Grid>
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
            <Border Classes="banner error" IsVisible="{Binding HasProblem}">
              <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Guests}" IsVisible="{Binding IsActive}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="cal:GuestItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2" ToolTip.Tip="{Binding Email}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="small" Text="{Binding ResponseText}" Margin="8,0,0,0"
                               Foreground="{Binding ResponseBrushKey, Converter={x:Static conv:ResourceBrushConverter.Instance}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding ShowConnectHint}"
                       Text="To send invites, connect a Google account in Settings → Google Calendar." />

            <!-- Choosing guests -->
            <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
              <TextBlock Classes="small" Text="Team members" />
              <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" MaxHeight="200">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding People}" Margin="8,4">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="work:PersonOption">
                        <CheckBox Content="{Binding FullName}" IsChecked="{Binding IsSelected}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <TextBlock Classes="small" Text="Other guests (e-mail addresses, separated by commas)" />
              <TextBox Text="{Binding ExtraEmails}" PlaceholderText="name@example.com, …" TextWrapping="Wrap" AcceptsReturn="False" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Send invites" Command="{Binding SendCommand}" />
                <Button Content="Cancel" Command="{Binding CancelEditingCommand}" />
              </StackPanel>
            </StackPanel>

            <Border Classes="banner error" IsVisible="{Binding IsConfirmingRemove}">
              <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="Take this event off everyone's Google Calendar? Google will tell them it was cancelled. The event stays in DOF." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Remove" Command="{Binding RemoveCommand}" />
                  <Button Content="Keep" Command="{Binding KeepInvitesCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <WrapPanel IsVisible="{Binding !IsConfirmingRemove}">
              <Button Content="{Binding SendButtonText}" Command="{Binding StartEditingCommand}" IsVisible="{Binding CanSend}" Margin="0,0,8,4" />
              <Button Content="Edit guests…" Command="{Binding StartEditingCommand}" IsVisible="{Binding CanEditGuests}" Margin="0,0,8,4" />
              <Button Content="Remove from Google Calendar…" Command="{Binding AskRemoveCommand}" IsVisible="{Binding CanRemove}" Margin="0,0,8,4" />
            </WrapPanel>
            <TextBlock Classes="muted small" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="3" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="muted small" Text="Notes" />
          <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Classes="muted small" Text="{Binding AuditText}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
