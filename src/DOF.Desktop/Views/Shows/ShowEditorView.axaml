<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shows="using:DOF.Desktop.ViewModels.Shows"
             xmlns:pages="using:DOF.Desktop.ViewModels.Pages"
             xmlns:pageViews="using:DOF.Desktop.Views.Pages"
             xmlns:conv="using:DOF.Desktop.Converters"
             x:Class="DOF.Desktop.Views.Shows.ShowEditorView"
             x:DataType="shows:ShowEditorViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,16,12,8">
      <TextBlock Classes="h2" Text="{Binding Heading}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Classes="toolbar" Content="✕" ToolTip.Tip="Close without saving"
              Command="{Binding $parent[pageViews:ShowsView].((pages:ShowsViewModel)DataContext).CloseSidePanelCommand}" />
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Margin="20,8,20,20" Spacing="10">
      <Border Classes="banner error" IsVisible="{Binding HasError}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Save" IsDefault="True"
                Command="{Binding $parent[pageViews:ShowsView].((pages:ShowsViewModel)DataContext).SaveShowCommand}" CommandParameter="{Binding}" />
        <Button Content="Discard" Command="{Binding $parent[pageViews:ShowsView].((pages:ShowsViewModel)DataContext).CloseSidePanelCommand}" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Margin="20,0,20,8" Spacing="12">
        <StackPanel Spacing="4"><TextBlock Text="Name" /><TextBox Text="{Binding Name}" PlaceholderText="e.g. Faith Conversations" /></StackPanel>
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Spacing="4">
            <TextBlock Text="Type" />
            <ComboBox ItemsSource="{Binding ShowTypes}" SelectedItem="{Binding ShowType}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding Converter={x:Static conv:HumanizeConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="Usual length (minutes)" />
            <NumericUpDown Value="{Binding DurationMinutes}" Minimum="1" Maximum="1440" Increment="15" FormatString="0" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
        <StackPanel Spacing="4">
          <TextBlock Text="Producer" />
          <ComboBox ItemsSource="{Binding Producers}" SelectedItem="{Binding SelectedProducer}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="muted small" Text="The show's producer can edit it and add seasons and episodes." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Description" />
          <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
