<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shows="using:DOF.Desktop.ViewModels.Shows"
             xmlns:pages="using:DOF.Desktop.ViewModels.Pages"
             xmlns:pageViews="using:DOF.Desktop.Views.Pages"
             xmlns:conv="using:DOF.Desktop.Converters"
             x:Class="DOF.Desktop.Views.Shows.SeasonEditorView"
             x:DataType="shows:SeasonEditorViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,16,12,8">
      <TextBlock Classes="h2" Text="{Binding Heading}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Classes="toolbar" Content="✕" ToolTip.Tip="Close without saving"
              Command="{Binding $parent[pageViews:ShowsView].((pages:ShowsViewModel)DataContext).CloseSidePanelCommand}" />
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Margin="20,8,20,20" Spacing="10">
      <Border Classes="banner error" IsVisible="{Binding HasError}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Save" IsDefault="True"
                Command="{Binding $parent[pageViews:ShowsView].((pages:ShowsViewModel)DataContext).SaveSeasonCommand}" CommandParameter="{Binding}" />
        <Button Content="Discard" Command="{Binding $parent[pageViews:ShowsView].((pages:ShowsViewModel)DataContext).CloseSidePanelCommand}" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Margin="20,0,20,8" Spacing="12">
        <Grid ColumnDefinitions="110,12,*">
          <StackPanel Spacing="4">
            <TextBlock Text="Number" />
            <NumericUpDown Value="{Binding SeasonNumber}" Minimum="1" Maximum="999" FormatString="0" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Name (optional)" /><TextBox Text="{Binding Name}" PlaceholderText="e.g. Beginnings" /></StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Spacing="4"><TextBlock Text="Starts" /><CalendarDatePicker SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch" /></StackPanel>
          <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Ends" /><CalendarDatePicker SelectedDate="{Binding EndDate}" HorizontalAlignment="Stretch" /></StackPanel>
        </Grid>
        <StackPanel Spacing="4" IsVisible="{Binding IsExisting}">
          <TextBlock Text="Status" />
          <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding Converter={x:Static conv:HumanizeConverter.Instance}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
