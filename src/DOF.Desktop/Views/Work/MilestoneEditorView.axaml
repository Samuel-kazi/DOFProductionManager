<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:work="using:DOF.Desktop.ViewModels.Work"
             xmlns:pages="using:DOF.Desktop.ViewModels.Pages"
             xmlns:pageViews="using:DOF.Desktop.Views.Pages"
             xmlns:conv="using:DOF.Desktop.Converters"
             x:Class="DOF.Desktop.Views.Work.MilestoneEditorView"
             x:DataType="work:MilestoneEditorViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,16,12,8">
      <TextBlock Classes="h2" Text="{Binding Heading}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="toolbar" Content="✕" ToolTip.Tip="Close"
              Command="{Binding $parent[pageViews:ProjectsView].((pages:ProjectsViewModel)DataContext).CloseSidePanelCommand}" />
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Margin="20,8,20,20" Spacing="10">
      <Border Classes="banner error" IsVisible="{Binding HasError}"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /></Border>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanSave}">
        <Button Classes="accent" Content="Save" IsDefault="True"
                Command="{Binding $parent[pageViews:ProjectsView].((pages:ProjectsViewModel)DataContext).SaveMilestoneCommand}" CommandParameter="{Binding}" />
        <Button Content="Discard" Command="{Binding $parent[pageViews:ProjectsView].((pages:ProjectsViewModel)DataContext).CloseSidePanelCommand}" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Margin="20,0,20,8" Spacing="12" IsEnabled="{Binding CanSave}">
        <StackPanel Spacing="4"><TextBlock Text="Title" /><TextBox Text="{Binding Title}" PlaceholderText="e.g. Rough cut ready" /></StackPanel>
        <StackPanel Spacing="4"><TextBlock Text="Due" /><CalendarDatePicker SelectedDate="{Binding DueDate}" Width="170" /></StackPanel>
        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Spacing="4">
            <TextBlock Text="Status" />
            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsNew}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding Converter={x:Static conv:HumanizeConverter.Instance}}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="Priority" />
            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
        <StackPanel Spacing="4">
          <TextBlock Text="Responsible" />
          <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Notes" />
          <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
