<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:DOF.Desktop.ViewModels.Pages"
             xmlns:responses="using:DOF.Contracts.Responses"
             xmlns:pageViews="using:DOF.Desktop.Views.Pages"
             x:Class="DOF.Desktop.Views.Pages.SettingsView"
             x:DataType="pages:SettingsViewModel"
             x:Name="Root">
  <ScrollViewer>
    <StackPanel Margin="32,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Profile" />
          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" >
            <TextBlock Classes="muted" Text="Name" Grid.Row="0" Margin="0,4" />
            <TextBlock Text="{Binding FullName}" Grid.Row="0" Grid.Column="1" Margin="0,4" />
            <TextBlock Classes="muted" Text="Email" Grid.Row="1" Margin="0,4" />
            <TextBlock Text="{Binding Email}" Grid.Row="1" Grid.Column="1" Margin="0,4" />
            <TextBlock Classes="muted" Text="Timezone" Grid.Row="2" Margin="0,4" />
            <TextBlock Text="{Binding TimeZone}" Grid.Row="2" Grid.Column="1" Margin="0,4" />
            <TextBlock Classes="muted" Text="Roles" Grid.Row="3" Margin="0,4" />
            <TextBlock Text="{Binding Roles}" Grid.Row="3" Grid.Column="1" Margin="0,4" />
          </Grid>
          <TextBlock Classes="muted small" Text="An administrator can change your name, email, timezone and roles." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Your name and timezone" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Calendar times, reminders and reports use your timezone. Your e-mail and roles are managed by an administrator." />
          <Grid ColumnDefinitions="*,12,*">
            <StackPanel Spacing="4"><TextBlock Text="Name" /><TextBox Text="{Binding EditableName}" /></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Timezone" />
              <ComboBox ItemsSource="{Binding TimeZones}" SelectedItem="{Binding SelectedTimeZone}" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="accent" Content="Save" Command="{Binding SaveProfileCommand}" />
            <TextBlock Classes="muted small" Text="{Binding ProfileMessage}" IsVisible="{Binding HasProfileMessage}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Calendar and notifications" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Open the calendar in" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding CalendarViews}" SelectedItem="{Binding DefaultCalendarView}" Width="140" />
          </StackPanel>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Notification channels and default reminder times are on the Reminders page." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Appearance" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Theme" VerticalAlignment="Center" Width="128" />
            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" MinWidth="160" />
          </StackPanel>
          <TextBlock Classes="muted small" Text="System follows your computer's light or dark setting." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Change password" />
          <TextBox Text="{Binding CurrentPassword}" PasswordChar="•" PlaceholderText="Current password" MaxWidth="360" HorizontalAlignment="Left" MinWidth="360" />
          <TextBox Text="{Binding NewPassword}" PasswordChar="•" PlaceholderText="New password (at least 10 characters)" MinWidth="360" HorizontalAlignment="Left" />
          <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•" PlaceholderText="Confirm new password" MinWidth="360" HorizontalAlignment="Left" />
          <Border Classes="banner error" IsVisible="{Binding PasswordMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Classes.success="{Binding PasswordChanged}">
            <TextBlock Text="{Binding PasswordMessage}" TextWrapping="Wrap" />
          </Border>
          <Button Content="Change password" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Server" />
          <TextBlock Classes="muted" Text="{Binding ServerAddress, StringFormat='Address: {0}'}" />
          <TextBlock Classes="muted" Text="{Binding ServerVersion, StringFormat='Version: {0}'}" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding CanManageChannels}" x:Name="GoogleCard">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Google Calendar" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Connect the Google account that sends calendar invites. People you invite to an event get it in their Google Calendar, and it updates when the event changes in DOF." />
          <TextBlock Text="{Binding GoogleStatusText}" TextWrapping="Wrap" />
          <Border Classes="banner error" IsVisible="{Binding HasGoogleProblem}">
            <TextBlock Text="{Binding GoogleProblem}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding IsGoogleNotConfigured}"
                     Text="The server needs a Google client ID, client secret and token encryption key (see DEPLOYMENT.md, Google Calendar)." />
          <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding IsConnectingGoogle}"
                     Text="Finish signing in to Google in your browser…" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsConfirmingGoogleDisconnect}">
            <Button Classes="accent" Content="Connect Google account…" Command="{Binding ConnectGoogleCommand}"
                    IsEnabled="{Binding CanConnectGoogle}" IsVisible="{Binding !IsGoogleConnected}" />
            <Button Content="Connect a different account…" Command="{Binding ConnectGoogleCommand}"
                    IsEnabled="{Binding CanConnectGoogle}" IsVisible="{Binding IsGoogleConnected}" />
            <Button Content="Disconnect…" Command="{Binding AskDisconnectGoogleCommand}" IsVisible="{Binding IsGoogleConnected}" />
          </StackPanel>
          <Border Classes="banner error" IsVisible="{Binding IsConfirmingGoogleDisconnect}">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap"
                         Text="Disconnect Google Calendar? Events already sent stay on people's calendars but stop updating, and new invites can't be sent until an account is connected." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Disconnect" Command="{Binding DisconnectGoogleCommand}" />
                <Button Content="Keep connected" Command="{Binding KeepGoogleCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="muted small" Text="{Binding GoogleMessage}" IsVisible="{Binding HasGoogleMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding CanManageChannels}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Distribution channels" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Where episodes are published. Deactivated channels keep their releases but take no new ones." />
          <pageViews:PageStatus />
          <ItemsControl ItemsSource="{Binding Channels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="responses:DistributionChannelResponse">
                <Grid ColumnDefinitions="*,110,Auto" Margin="0,3">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Classes.muted="{Binding !IsActive}" />
                  <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding ChannelType}" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsActive, Mode=OneWay}" OnContent="Active" OffContent="Inactive"
                                Command="{Binding #Root.((pages:SettingsViewModel)DataContext).ToggleChannelCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,8,130,8,Auto">
            <TextBox Text="{Binding NewChannelName}" PlaceholderText="New channel name" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding ChannelTypes}" SelectedItem="{Binding NewChannelType}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="4" Content="Add" Command="{Binding AddChannelCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
