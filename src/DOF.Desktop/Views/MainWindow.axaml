<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DOF.Desktop.ViewModels"
        x:Class="DOF.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DOF Production Manager"
        Width="1280" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource Brush.App}">
  <Grid RowDefinitions="Auto,*">
    <!-- App-wide error banner: unexpected failures are shown, never silently swallowed. -->
    <Border Grid.Row="0" Classes="banner error" CornerRadius="0" IsVisible="{Binding HasAppError}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding AppError}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Dismiss" Margin="12,0,0,0" Command="{Binding DismissAppErrorCommand}" />
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding Content}" />

    <StackPanel Grid.Row="1" IsVisible="{Binding IsStarting}" Spacing="14"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <Path Classes="icon" Data="{StaticResource Icon.Sunrise}" Width="40" Height="40"
            Stroke="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
      <TextBlock Classes="h2" Text="DOF Production Manager" HorizontalAlignment="Center" />
      <ProgressBar IsIndeterminate="True" Width="220" />
      <TextBlock Classes="muted" Text="Connecting…" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
