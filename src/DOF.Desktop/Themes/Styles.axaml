<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typography -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Offline}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.banner.error">
    <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
  </Style>
  <Style Selector="Border.banner.success">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>

  <!-- Icons: a Path whose Data is an icon geometry -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding $parent[ContentPresenter].Foreground}" />
  </Style>

  <!-- Sidebar navigation buttons -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}" />
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.NavSelected}" />
  </Style>
  <Style Selector="Button.nav.selected Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Button.nav.selected TextBlock.navlabel">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.sidebar.collapsed TextBlock.navlabel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.sidebar.collapsed StackPanel.expandedOnly">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Quiet toolbar buttons -->
  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Toolbar icons draw in the text colour (the generic binding does not resolve inside toolbar buttons). -->
  <Style Selector="Button.toolbar Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.toolbar:disabled Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Search box in the top bar -->
  <Style Selector="TextBox.search">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.search:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Brush.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>

  <!-- Connection indicator -->
  <Style Selector="Ellipse.status">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Checking}" />
  </Style>
  <Style Selector="Ellipse.status.online">
    <Setter Property="Fill" Value="{DynamicResource Brush.Online}" />
  </Style>
  <Style Selector="Ellipse.status.offline">
    <Setter Property="Fill" Value="{DynamicResource Brush.Offline}" />
  </Style>

  <!-- Work rows: overdue dates in red, finished work struck through. -->
  <Style Selector="TextBlock.overdue">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Offline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.done">
    <Setter Property="TextDecorations" Value="Strikethrough" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="Border.statusDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Episode production timeline: done stages filled, the current one outlined in the accent colour. -->
  <Style Selector="Border.stage">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="MinWidth" Value="112" />
  </Style>
  <Style Selector="Border.stage.done">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessSoft}" />
  </Style>
  <Style Selector="Border.stage.current">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.stage.cancelled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Unread notification count on the bell -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource Brush.Offline}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnStatus}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Avatars -->
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="Border.avatar > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
</Styles>
