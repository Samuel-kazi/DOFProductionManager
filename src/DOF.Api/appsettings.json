{
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Organisation": {
    "DefaultTimeZone": "Africa/Nairobi"
  },
  "Jwt": {
    "Issuer": "dof-production-manager",
    "Audience": "dof-production-manager-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RateLimiting": {
    "AuthPermitLimitPerMinute": 10
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "System Administrator"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}