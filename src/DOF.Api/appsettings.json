{
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Organisation": {
    "DefaultTimeZone": "Africa/Nairobi"
  },
  "Jwt": {
    "Issuer": "dof-production-manager",
    "Audience": "dof-production-manager-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RateLimiting": {
    "AuthPermitLimitPerMinute": 10
  },
  "BackgroundJobs": {
    "Enabled": true,
    "RunServer": true
  },
  "Reminders": {
    "MaxDeliveryAttempts": 5,
    "EscalationAfterHours": 24,
    "DateOnlyReminderHour": 9,
    "ReconcileHorizonDays": 60,
    "OutboxRetentionDays": 30
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "FromAddress": "",
    "FromName": "DOF Production Manager"
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "System Administrator"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}