# Copy to .env next to this file and fill in real values. Never commit .env (it is git-ignored).
POSTGRES_DB=dof_production_manager
POSTGRES_USER=dof_pm
# Long random value, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=
ORGANISATION_TIMEZONE=Africa/Nairobi
# At least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=
# Used only to create the first administrator on an empty database; remove after first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional: leave EMAIL_HOST empty to run without e-mail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
